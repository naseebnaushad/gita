<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundled `gita` command is a Dart AOT executable. Under the
	     hardened runtime, current macOS kills it at launch (SIGKILL,
	     exit 137) unless it may map unsigned executable memory.
	     allow-jit alone is not enough. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
